/target
**/target
_external/
*.pdf
.DS_Store

/.demo/
# Every testnet working directory and wallet home, present and future. These
# hold members.json and account keys, so the patterns are globs: an enumeration
# only ever covers the directories that existed when it was written, and the
# next one created is exactly the one that gets committed.
/.testnet*/
/.wallet*/
/_external/

# Basecamp app build output, and the metadata copy CMake stages for moc
/app/build/
/app/src/metadata.json

/.linux-variant/
/.linux-msig
/app/build-linux/
